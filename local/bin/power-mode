#!/usr/bin/env bash
set -euo pipefail

choice="${1:-}"

if [[ -z "$choice" ]]; then
  choice="$(printf '%s\n' \
    'Экономный' \
    'Сбалансированный' \
    'Производительность' \
    | wofi --dmenu --prompt 'Питание' --lines 3 --width 280 --height 160 --cache-file /dev/null)"
fi

case "$choice" in
  power-saver|Экономный)
    powerprofilesctl set power-saver
    notify-send "Режим питания" "power-saver" --icon=battery
    ;;
  balanced|Сбалансированный)
    powerprofilesctl set balanced
    notify-send "Режим питания" "balanced" --icon=battery
    ;;
  performance|Производительность)
    powerprofilesctl set performance
    notify-send "Режим питания" "performance" --icon=battery
    ;;
  *)
    exit 1
    ;;
esac
