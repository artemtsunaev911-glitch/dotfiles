#!/usr/bin/env bash
set -euo pipefail

theme="${1:-bw}"

# Если передали файл картинки напрямую
if [[ -f "$theme" ]]; then
  WALLPAPER="$theme"
else
  WALLPAPER=""
  for candidate in \
    "$HOME/Pictures/Wallpapers/${theme}.jpg" \
    "$HOME/Pictures/Wallpapers/${theme}.png" \
    "$HOME/dotfiles/assets/wallpapers/${theme}.jpg" \
    "$HOME/dotfiles/assets/wallpapers/${theme}.png"
  do
    if [[ -f "$candidate" ]]; then
      WALLPAPER="$candidate"
      break
    fi
  done
fi

if [[ -z "$WALLPAPER" ]]; then
  echo "Wallpaper not found for: $theme"
  exit 1
fi

# Генерируем палитру и применяем шаблоны
wallust run "$WALLPAPER"

# Ставим обои
if ! pgrep -x awww-daemon >/dev/null 2>&1; then
  awww-daemon >/dev/null 2>&1 &
  sleep 0.5
fi

awww img "$WALLPAPER" --transition-type fade --transition-duration 1.2

# Перезапускаем
pkill waybar 2>/dev/null || true
waybar >/dev/null 2>&1 &
disown

pkill swaync 2>/dev/null || true
swaync >/dev/null 2>&1 &
disown

hyprctl reload >/dev/null 2>&1 || true

# Запоминаем
mkdir -p ~/.config/rice
echo "$theme" > ~/.config/rice/current-theme

notify-send "Тема" "Применена: $theme"
